# Maintainer: Bruno Gonçalves <www.biglinux.com.br>

pkgbase=speech-enhancement-native
pkgname=(deepfilternet3-native dpdfnet-native gtcrn-aec-native)
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
url="https://github.com/biglinux/${pkgbase}"
makedepends=('git' 'rust')
source=("git+${url}.git")
md5sums=('SKIP')

prepare() {
    cd "${srcdir}/${pkgbase}" || return
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "${srcdir}/${pkgbase}" || return
    cargo build --frozen --release --workspace --exclude dpdfnet-native
    cargo build --frozen --profile release-unwind -p dpdfnet-native
}

check() {
    cd "${srcdir}/${pkgbase}" || return
    export AEC_GTCRN_GGUF="${PWD}/gtcrn-aec/model/localvqe-pi-aec-v1-49k-f32.gguf"
    export DPDFNET_TEST_MODEL="${PWD}/dpdfnet/model/dpdfnet2_48khz_hr-w8a16"
    cargo test --frozen --release --workspace --exclude dpdfnet-native
    cargo test --frozen --profile release-unwind -p dpdfnet-native
    cargo test --frozen --profile release-unwind -p dpdfnet-native --test runtime --test offline -- --ignored
}

_licenses() {
    install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" LICENSE-MIT LICENSE-APACHE NOTICE
}

package_deepfilternet3-native() {
    pkgdesc='DeepFilterNet3 and DeepFilterNet3-LL noise suppression, native int8/SIMD Rust engine (LADSPA plugins)'
    license=('MIT OR Apache-2.0')
    depends=('libgcc' 'glibc')
    # Transition from deepfilternet-quantized-ladspa, which also held the AEC:
    # the unversioned provides keeps its dependants installable and does not
    # match the versioned conflicts below.
    provides=('deepfilternet-quantized-ladspa')
    conflicts=('deepfilternet-quantized-ladspa<26')
    replaces=('deepfilternet-quantized-ladspa<26')

    cd "${srcdir}/${pkgbase}" || return
    install -Dm755 -t "${pkgdir}/usr/lib/ladspa" \
        target/release/libdfn3_ladspa.so \
        target/release/libdfn3ll_ladspa.so \
        target/release/liblimiter_ladspa.so
    _licenses
    install -Dm644 deepfilternet3/LICENSE-DeepFilterNet-MIT \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-DeepFilterNet-MIT"
}

package_dpdfnet-native() {
    pkgdesc='DPDFNet-2 48 kHz HR noise suppression, native int8/SIMD Rust engine (LADSPA plugin and multithreaded file tool)'
    license=('MIT OR Apache-2.0' 'Apache-2.0')
    depends=('libgcc' 'glibc')

    cd "${srcdir}/${pkgbase}" || return
    install -Dm755 target/release-unwind/libdpdfnet_native.so "${pkgdir}/usr/lib/ladspa/libdpdfnet_native.so"
    install -Dm755 target/release-unwind/dpdfnet-enhance "${pkgdir}/usr/bin/dpdfnet-enhance"
    install -Dm644 -t "${pkgdir}/usr/share/dpdfnet-native/dpdfnet2_48khz_hr-w8a16" \
        dpdfnet/model/dpdfnet2_48khz_hr-w8a16/{manifest.json,packing.json,weights.bin}
    _licenses
    install -Dm644 dpdfnet/model/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-DPDFNet"
}

package_gtcrn-aec-native() {
    pkgdesc='GTCRN-AEC acoustic echo cancellation, native Rust engine (PipeWire SPA AEC plugin)'
    license=('MIT OR Apache-2.0' 'Apache-2.0')
    depends=('libgcc' 'glibc')
    conflicts=('deepfilternet-quantized-ladspa<26')
    replaces=('deepfilternet-quantized-ladspa<26')

    cd "${srcdir}/${pkgbase}" || return
    install -Dm755 target/release/libspa_aec_gtcrn.so "${pkgdir}/usr/lib/spa-0.2/aec/libspa-aec-gtcrn.so"
    install -Dm644 gtcrn-aec/model/localvqe-pi-aec-v1-49k-f32.gguf \
        "${pkgdir}/usr/share/gtcrn-aec-native/localvqe-pi-aec-v1-49k-f32.gguf"
    _licenses
    install -Dm644 gtcrn-aec/model/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-LocalVQE"
}
